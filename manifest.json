{
  "manifest_version": 3,
  "name": "agy in chrome",
  "description": "Open Antigravity from Chrome and prepare context from your current tab.",
  "version": "0.3.1",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "agy in chrome"
  },
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
