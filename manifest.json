{
  "manifest_version": 3,
  "name": "agy in chrome",
  "description": "Open the official Antigravity Remote Control in the Chrome side panel.",
  "version": "0.7.0",
  "minimum_chrome_version": "157",
  "permissions": [
    "sidePanel",
    "activeTab",
    "contextMenus",
    "clipboardWrite",
    "scripting",
    "storage"
  ],
  "action": {
    "default_title": "agy in chrome"
  },
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "optional_permissions": [
    "tabs"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
