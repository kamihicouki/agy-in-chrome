{
  "manifest_version": 3,
  "name": "agy in chrome",
  "description": "Talk to Antigravity in the Chrome side panel with context from the current tab.",
  "version": "0.4.0",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "nativeMessaging"
  ],
  "action": {
    "default_title": "agy in chrome"
  },
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
